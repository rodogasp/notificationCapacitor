# --- Runtime ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# --- Database ---
# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://notification_user:notification_pass@localhost:5432/notification_db?schema=public

# --- Logging ---
# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# --- CORS ---
# Comma separated list of allowed origins, e.g. https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Firebase ---
FIREBASE_PROJECT_ID=your-firebase-project-id

# One of: adc (Application Default Credentials) | file (local service-account JSON file) | json (inline JSON)
FIREBASE_CREDENTIALS_MODE=adc

# Required when FIREBASE_CREDENTIALS_MODE=file. Path to a service-account JSON file.
# Never commit this file. Keep it outside of version control.
# For docker-compose: place the file at ./secrets/firebase-service-account.json
# (already git-ignored and mounted read-only into the container at /secrets)
# and set this to /secrets/firebase-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=

# Required when FIREBASE_CREDENTIALS_MODE=json. Inline JSON string of the service account.
# Prefer a secrets manager in production. Never commit real values.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Android notification channel id that must match the channel created on the client app
FCM_ANDROID_CHANNEL_ID=default_channel

# --- JWT authentication ---
JWT_ISSUER=https://issuer.example.com/
JWT_AUDIENCE=notification-backend

# Preferred in production: URL of the JSON Web Key Set used to verify signatures
JWT_JWKS_URL=https://issuer.example.com/.well-known/jwks.json

# Local-development only fallback: PEM-encoded public key (or HS256 shared secret) used when
# JWT_JWKS_URL is not set. Never rely on this in production.
JWT_PUBLIC_KEY=

# Role/scope claim value required to call notification-sending endpoints
NOTIFICATION_REQUIRED_ROLE=notification:send

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Body size ---
# Maximum accepted JSON body size, e.g. 100kb, 1mb
MAX_JSON_BODY_SIZE=100kb
